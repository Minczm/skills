  "interview_checklist": [
    {
      "id": "IC01",
      "target": "interviewer",
      "priority": "P0",
      "question": "团队目前常规产品迭代和大客户定制交付各占多大精力？季度末值班如何排班与调休？",
      "trigger_fact": "公开员工反馈提到大客户上线窗口期存在夜间值班，各组调休口径不一。",
      "good_signal": "有明确轮值表、次日可调休或补贴，且定制需求被隔离在交付团队。",
      "risk_signal": "模糊回应“看项目紧急程度”“大家都很拼”。",
      "sources": [
        "S003"
      ]
    },
    {
      "id": "IC02",
      "target": "hr",
      "priority": "P0",
      "question": "14 薪里保底是几薪？过去两年研发部门平均年终奖实际兑现了几个月？公积金按全额基数还是下限缴？",
      "trigger_fact": "招聘口径写 14 薪但合同保底 13 薪，浮动部分兑现率未公开。",
      "good_signal": "直接告知全额 12% 公积金及近两年实际中位数兑现月数。",
      "risk_signal": "只谈“最高可达”或回避公积金基数。",
      "sources": [
        "S002"
      ]
    },
    {
      "id": "IC03",
      "target": "contract",
      "priority": "P1",
      "question": "入职合同签约主体、发薪主体和社保缴纳主体是否全部为青禾云图科技有限公司？是否附带竞业限制协议？",
      "trigger_fact": "签字前需逐项核对劳动合同主体一致性及竞业触发条件。",
